[Unit]
Description=vmshield - libvirt 虚拟机出口白名单 (只允许 80/443/53/ICMP，禁止访问局域网)
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/ma-xiuyuan/vmshield/vmshield.sh on
ExecStop=/home/ma-xiuyuan/vmshield/vmshield.sh off

[Install]
WantedBy=multi-user.target
